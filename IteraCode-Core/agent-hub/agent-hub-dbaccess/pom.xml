<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agenthub</groupId>
        <artifactId>agent-hub</artifactId>
        <version>agent-hub-1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>com.agenthub</groupId>
    <artifactId>agent-hub-dbaccess</artifactId>
    <version>agent-hub-1.0</version>
    <packaging>jar</packaging>
    <name>agent-hub-dbaccess</name>
    <description>agent-hub 数据库访问公共模块（Java SPI 库：数据源注册表/中立元数据 Provider/方言/只读执行/敏感脱敏）</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <!--
      依赖版本统一来自父 pom dependencyManagement（spring-boot BOM / druid / mysql / fastjson2），本模块不写死版本。
      作为库模块，被 agent-hub-server 与 module-003/006/007/009 以 jar 依赖方式复用，无 HTTP Controller。
    -->
    <dependencies>
        <!-- Spring Boot 基础（context/autoconfigure/logging），提供 @Configuration/@Service/@ConfigurationProperties 能力 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 每 ds_id 独立只读 Druid 连接池（版本由父 pom druid.version 统一 1.2.23） -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>

        <!-- JSON 解析（白名单/限制/执行计划），版本由父 pom fastjson2.version 统一 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- MySQL 驱动（P0 目标库），运行期由驱动类名加载；Oracle/OceanBase 驱动 P0 不强引，P2 由部署侧提供 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OceanBase JDBC 驱动（OceanBase-MySQL / OceanBase-Oracle）：与 mysql-connector-j 并存；
             对 OB client 的传递依赖显式 exclusions，避免与既有依赖产生类路径冲突 -->
        <dependency>
            <groupId>com.oceanbase</groupId>
            <artifactId>oceanbase-client</artifactId>
            <scope>runtime</scope>
            <exclusions>
                <exclusion>
                    <groupId>net.java.dev.jna</groupId>
                    <artifactId>jna</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>net.java.dev.jna</groupId>
                    <artifactId>jna-platform</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.github.waffle</groupId>
                    <artifactId>waffle-jna</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Oracle JDBC 驱动（Oracle 11g/19c，JDBC 4.2，兼容 JDK 8+）；运行期由驱动类名加载 -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc8</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok（版本由 spring-boot BOM 管理），仅编译期 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 单元测试依赖（JUnit5 + Mockito + AssertJ，版本由 spring-boot BOM 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 编译器版本继承父 pom pluginManagement（source/target 17） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Surefire 3.x：支持 JUnit5 平台 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <!-- 覆盖率 profile：仅显式激活（-Pcoverage）时生成 jacoco 报告，不影响默认构建 -->
    <profiles>
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.12</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
