# 数据目录（运行时数据，默认 ./data）
LLM_WIKI_DATA_DIR=./data

# Embedding（Ollama OpenAI 兼容接口）
LLM_WIKI_EMBEDDING_BASE_URL=http://localhost:11434/v1
LLM_WIKI_EMBEDDING_API_KEY=ollama
LLM_WIKI_EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_WIKI_EMBEDDING_BATCH_SIZE=32

# 分块参数
LLM_WIKI_CHUNK_SIZE=2000
LLM_WIKI_CHUNK_OVERLAP=200

# 服务端口
LLM_WIKI_PORT=8000
